# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# offline = deterministic rules, no key needed | claude = use Claude for intent, lookup, and replies
LLM_MODE=offline
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
# USD per million tokens, used for cost reporting (Claude Haiku 5.5 list price for prompts under 100k tokens)
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50

# Business and safety rules
REFUND_APPROVAL_THRESHOLD=200
REFUND_WINDOW_DAYS=30
MAX_INPUT_CHARS=1000

# Storage (defaults shown; Docker overrides these to /data)
# DATA_DIR=tools/data
# MEMORY_DIR=memory/sessions
# LOG_DIR=ops/logs
# APPROVALS_FILE=security/approvals/queue.json

# Web demo
DEMO_AUTHOR=Umashanker
# DEMO_HOME_URL=https://umashanker.com   # shows an "All projects" link in the header
DEMO_DAILY_CLAUDE_REQUESTS=300
DEMO_MSGS_PER_10MIN=30
DEMO_IP_MSGS_PER_10MIN=80
